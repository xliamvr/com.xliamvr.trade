 */

(function (global) {
  'use strict';

  var TIMEFRAMES_4 = ['M5', 'M15', 'H1', 'H4'];

  function getBridge() {
    return global.__LIAM_TERMINAL_BRIDGE__ || null;
  }

  function showQuickNotice(msg) {
    var bridge = getBridge();
    if (bridge && typeof bridge.toast === 'function') {
      try { bridge.toast(msg, 'info'); } catch (e) {}
    }
    var container = document.getElementById('toast-container');
    if (!container) return;
    var box = document.createElement('div');
    box.className = 'px-3.5 py-2 rounded-xl bg-slate-900/95 border border-cyan-400/50 text-cyan-200 text-xs font-bold shadow-lg';
    box.textContent = msg;
    container.appendChild(box);
    setTimeout(function () {
      if (box && box.parentNode) box.parentNode.removeChild(box);
    }, 2400);
  }

  function getFallbackTerminalState() {
    var chartSelect = document.getElementById('chart-pair-select');
    var pair = (chartSelect && chartSelect.value) || 'XAUUSD';
    var methodSelect = document.getElementById('signal-method-select');
    var method = (methodSelect && methodSelect.value) || 'auto';

    var cachedPrices = {};
    try {
      var raw = localStorage.getItem('liamvtrade_last_live_prices_v2');
      if (raw) {
        var parsed = JSON.parse(raw);
        if (parsed && typeof parsed === 'object') cachedPrices = parsed;
      }
    } catch (e) {}

    var prices = {
      XAUUSD: Number(cachedPrices.XAUUSD) || 3555.00,
      US100: Number(cachedPrices.US100) || 21500.00,
      BTCUSDT: Number(cachedPrices.BTCUSDT) || 95000.00,
      EURUSD: Number(cachedPrices.EURUSD) || 1.08500
    };

    return {
      pair: pair,
      timeframe: 'M15',
      method: method,
      prices: prices,
      lastPriceUpdateMs: Number(cachedPrices.fetchedAtMs) || Date.now()
    };
  }

  function detectMarketRegime(state, setup) {
    var pair = (state && state.pair) || (setup && setup.pair) || 'XAUUSD';
    var tf = (state && state.timeframe) || (setup && setup.timeframe) || 'M15';
    var nyCtx = (global.LiamMethods && typeof global.LiamMethods.getNySessionContext === 'function')
      ? global.LiamMethods.getNySessionContext(Date.now())
      : { isWeekend: false, sessionName: 'Active Session' };

    if (nyCtx.isWeekend && pair !== 'BTCUSDT') {
      return {
        regime: 'WEEKEND / LOW LIQUIDITY',
        badgeColor: '#f59e0b',
        summary: 'Pasar utama libur akhir pekan; hindari entri agresif dan utamakan observasi struktur.',
        suggestedAction: 'NO TRADE / MONITOR ONLY'
      };
    }

    if (setup && setup.status === 'WAIT' && String(setup.reasonCode || '').indexOf('NEWS') !== -1) {
      return {
        regime: 'HIGH-VOLATILITY NEWS LOCK',
        badgeColor: '#ef4444',
        summary: 'Jendela rilis data berdampak tinggi aktif; rawan spread melebar dan sapuan likuiditas dua arah.',
        suggestedAction: 'WAIT FOR POST-NEWS STRUCTURE'
      };
    }

    var maxSlMap = (global.LiamMethods && global.LiamMethods.PAIR_SPECS && global.LiamMethods.PAIR_SPECS[pair] && global.LiamMethods.PAIR_SPECS[pair].maxSlPips) || {};
    var atrRatio = (Number(setup && setup.slPips) || 25) / (Number(maxSlMap[tf]) || 72);
    if (atrRatio >= 0.72) {
      return {
        regime: 'EXPANSION / HIGH VOLATILITY',
        badgeColor: '#38bdf8',
        summary: 'Volatilitas ' + pair + ' (' + tf + ') sedang ekspansif; utamakan konfirmasi pullback ke POI/FVG dengan risk disiplin.',
        suggestedAction: 'PULLBACK LIMIT / PARTIAL TP'
      };
    }

    return {
      regime: 'BALANCED / DEALING RANGE',
      badgeColor: '#10b981',
      summary: 'Struktur ' + pair + ' (' + tf + ') berada di area dealing range terukur; perhatikan reaksi di zona Discount/Premium & likuiditas.',
      suggestedAction: 'SELECTIVE SNIPER ENTRY'
    };
  }

  function buildFallbackScanItem(pair, tf, basePrice) {
    var px = Number(basePrice) || 3555.00;
    var isBuy = tf === 'M15' || tf === 'H1';
    var step = pair === 'EURUSD' ? 0.0025 : (pair === 'BTCUSDT' ? 650 : (pair === 'US100' ? 95 : 14));
    var entry = isBuy ? (px - step * 0.35) : (px + step * 0.35);
    var sl = isBuy ? (entry - step * 0.9) : (entry + step * 0.9);
    var tp1 = isBuy ? (entry + step * 1.1) : (entry - step * 1.1);
    var tp2 = isBuy ? (entry + step * 2.0) : (entry - step * 2.0);
    var tp3 = isBuy ? (entry + step * 3.0) : (entry - step * 3.0);

    var fmt = function (v) {
      if (pair === 'EURUSD') return v.toFixed(5);
      if (pair === 'BTCUSDT' || pair === 'US100') return v.toFixed(1);
      return v.toFixed(2);
    };

    var zoneLow = fmt(Math.min(entry, isBuy ? entry - step * 0.2 : entry));
    var zoneHigh = fmt(Math.max(entry, isBuy ? entry : entry + step * 0.2));

    return {
      pair: pair,
      timeframe: tf,
      status: 'SIGNAL',
      direction: isBuy ? 'BUY' : 'SELL',
      orderType: isBuy ? 'BUY LIMIT' : 'SELL LIMIT',
      methodLabel: 'Auto Sniper (Fallback Map)',
      sessionName: 'Active Session',
      score: tf === 'M15' ? '8.2' : '7.4',
      slPips: pair === 'EURUSD' ? 22 : 28,
      entryFmt: fmt(entry),
      slFmt: fmt(sl),
      tp1Fmt: fmt(tp1),
      tp2Fmt: fmt(tp2),
      tp3Fmt: fmt(tp3),
      zoneRangeFormatted: zoneLow + ' - ' + zoneHigh,
      poiSummary: (isBuy ? 'Bullish OB + FVG' : 'Bearish OB + FVG') + ' pada ' + tf + ' (' + zoneLow + ' - ' + zoneHigh + ').'
    };
  }

  function runFourTimeframeScan(state, options) {
    var opts = options || {};
    var bridge = getBridge();
    var methods = global.LiamMethods;
    var pair = opts.pair || (state && state.pair) || 'XAUUSD';
    var method = opts.method || (state && state.method) || 'auto';
    var statePrices = (state && state.prices) || {};
    var livePrice = Number(opts.livePrice !== undefined ? opts.livePrice : statePrices[pair]);
    var lastUpdateTs = Number(opts.lastUpdateTs || (state && state.lastPriceUpdateMs) || Date.now());
    var newsInfo = opts.newsInfo || {};

    var results = [];
    if (methods && typeof methods.buildSignalSetup === 'function') {
      results = TIMEFRAMES_4.map(function (tf) {
        try {
          return methods.buildSignalSetup({
            pair: pair,
            timeframe: tf,
            method: method,
            livePrice: livePrice,
            lastUpdateTs: lastUpdateTs,
            nowMs: Date.now(),
            spreadPips: state && state.spreadPips,
            htfBias: state && state.htfBias,
            newsLockActive: Boolean(newsInfo.locked),
            newsBias: (newsInfo.event && newsInfo.event.verdictDirection) || '',
            forceReanalyze: Boolean(opts.forceReanalyze),
            scanSeed: Number(state && state.scanCounter) || 1
          });
        } catch (e) {
          return buildFallbackScanItem(pair, tf, livePrice);
        }
      });
    } else {
      results = TIMEFRAMES_4.map(function (tf) {
        return buildFallbackScanItem(pair, tf, livePrice);
      });
    }

    var executable = results
      .filter(function (r) { return r && r.status === 'SIGNAL'; })
      .sort(function (a, b) { return (Number(b.score) || 0) - (Number(a.score) || 0); });

    var best = executable[0] || results.find(function (r) { return r && r.status === 'WAIT'; }) || results[1] || results[0] || null;

    if (opts.applyBest && best && bridge && typeof bridge.getState === 'function') {
      var st = bridge.getState();
      st.timeframe = best.timeframe;
      if (typeof bridge.runAnalysis === 'function') {
        bridge.runAnalysis({ skipScanIncrement: true });
      }
    }

    return { results: results, best: best };
  }

  function renderFourTimeframeGrid(containerId, scanData, onSelectTf) {
    var el = document.getElementById(containerId);
    if (!el || !scanData || !Array.isArray(scanData.results)) return;

    el.innerHTML = scanData.results
      .map(function (item) {
        var isSig = item.status === 'SIGNAL';
        var isWait = item.status === 'WAIT';
        var statusBadge = isSig
          ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">' + item.direction + ' • ' + item.score + '</span>'
          : isWait
          ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">WAIT</span>'
          : '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">NO SETUP</span>';

        var detailLine = isSig
          ? ('Entry ' + item.entryFmt + ' • SL ' + item.slPips + 'p • TP1 ' + item.tp1Fmt)
          : (item.poiSummary || item.reasonCode || 'Tidak ada setup valid');

        return (
          '<button type="button" data-tf-scan="' + item.timeframe + '" ' +
          'class="text-left p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800/90 border border-slate-700/70 transition flex flex-col justify-between gap-2">' +
          '<div class="flex items-center justify-between gap-2">' +
          '<span class="text-xs font-extrabold tracking-wide text-slate-100">' + item.timeframe + '</span>' +
          statusBadge +
          '</div>' +
          '<div class="text-[11px] text-slate-300 font-mono leading-snug">' + detailLine + '</div>' +
          '</button>'
        );
      })
      .join('');

    el.querySelectorAll('[data-tf-scan]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tf = btn.getAttribute('data-tf-scan');
        if (typeof onSelectTf === 'function') onSelectTf(tf);
      });
    });
  }

  function paintMappingCanvas(targetCanvas, setup, state, regimeInfo) {
    if (!targetCanvas) return null;
    var ctx = targetCanvas.getContext('2d');
    if (!ctx) return null;

    var w = targetCanvas.width || 900;
    var h = targetCanvas.height || 520;

    var bgGrad = ctx.createLinearGradient(0, 0, w, h);
    bgGrad.addColorStop(0, '#070b12');
    bgGrad.addColorStop(1, '#101827');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, w, h);

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.09)';
    ctx.lineWidth = 1;
    for (var x = 45; x < w - 30; x += 45) {
      ctx.beginPath();
      ctx.moveTo(x, 70);
      ctx.lineTo(x, h - 55);
      ctx.stroke();
    }
    for (var y = 70; y <= h - 55; y += 45) {
      ctx.beginPath();
      ctx.moveTo(45, y);
      ctx.lineTo(w - 45, y);
      ctx.stroke();
    }

    var pair = (setup && setup.pair) || (state && state.pair) || 'XAUUSD';
    var tf = (setup && setup.timeframe) || (state && state.timeframe) || 'M15';

    ctx.fillStyle = '#f8fafc';
    ctx.font = 'bold 20px Inter, system-ui, sans-serif';
    ctx.fillText('LIAMVTRADE MAP — ' + pair + ' (' + tf + ')', 36, 38);

    ctx.fillStyle = '#94a3b8';
    ctx.font = '600 12px monospace';
    ctx.fillText('Regime: ' + ((regimeInfo && regimeInfo.regime) || 'BALANCED') + ' | Status: ' + ((setup && setup.status) || 'NO SETUP'), 36, 58);

    var chartLeft = 40;
    var chartRight = Math.floor(w * 0.64);
    var hasSignal = Boolean(setup && setup.status === 'SIGNAL');
    var isBuy = Boolean(setup && setup.direction === 'BUY');

    if (hasSignal) {
      ctx.fillStyle = isBuy ? 'rgba(16, 185, 129, 0.16)' : 'rgba(244, 63, 94, 0.16)';
      ctx.fillRect(chartLeft, 225, chartRight - chartLeft, 68);

      ctx.strokeStyle = isBuy ? '#34d399' : '#fb7185';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(chartLeft, 225, chartRight - chartLeft, 68);

      var pts = isBuy
        ? [[55, 170], [120, 200], [185, 180], [250, 240], [315, 275], [380, 255], [445, 205], [510, 155], [555, 125]]
        : [[55, 365], [120, 330], [185, 350], [250, 290], [315, 255], [380, 275], [445, 325], [510, 380], [555, 415]];

      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      for (var i = 0; i < pts.length; i++) {
        if (i === 0) ctx.moveTo(pts[i][0], pts[i][1]);
        else ctx.lineTo(pts[i][0], pts[i][1]);
      }
      ctx.stroke();

      var levels = [
        { label: 'TP3 ' + setup.tp3Fmt, y: isBuy ? 125 : 415, color: '#38bdf8' },
        { label: 'TP2 ' + setup.tp2Fmt, y: isBuy ? 160 : 380, color: '#2dd4bf' },
        { label: 'TP1 ' + setup.tp1Fmt, y: isBuy ? 198 : 340, color: '#10b981' },
        { label: 'ENTRY ' + setup.entryFmt, y: 255, color: '#facc15' },
        { label: 'SL ' + setup.slFmt + ' (' + setup.slPips + 'p)', y: isBuy ? 355 : 165, color: '#f43f5e' }
      ];

      for (var j = 0; j < levels.length; j++) {
        var lvl = levels[j];
        ctx.strokeStyle = lvl.color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(chartLeft, lvl.y);
        ctx.lineTo(chartRight, lvl.y);
        ctx.stroke();

        ctx.fillStyle = lvl.color;
        ctx.font = 'bold 11px monospace';
        ctx.fillText(lvl.label, chartLeft + 8, lvl.y - 5);
      }
    } else {
      ctx.fillStyle = 'rgba(245, 158, 11, 0.14)';
      ctx.fillRect(chartLeft, 180, chartRight - chartLeft, 150);
      ctx.fillStyle = '#fbbf24';
      ctx.font = 'bold 20px Inter, system-ui, sans-serif';
      ctx.fillText((setup && setup.status) || 'NO SETUP', chartLeft + 24, 240);
      ctx.fillStyle = '#cbd5e1';
      ctx.font = '13px Inter, system-ui, sans-serif';
      ctx.fillText(String((setup && setup.poiSummary) || 'Menunggu struktur valid.').slice(0, 56), chartLeft + 24, 270);
    }

    var panelX = chartRight + 24;
    var panelW = w - panelX - 32;
    ctx.fillStyle = 'rgba(15, 23, 42, 0.92)';
    ctx.fillRect(panelX, 85, panelW, h - 145);
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(panelX, 85, panelW, h - 145);

    ctx.fillStyle = '#f8fafc';
    ctx.font = 'bold 15px Inter, system-ui, sans-serif';
    ctx.fillText('EXECUTION BRIEF', panelX + 16, 115);

    var rows = [
      ['Status', (setup && setup.status) || 'NO SETUP'],
      ['Arah', (setup && setup.direction) || '-'],
      ['Order', (setup && setup.orderType) || '-'],
      ['Entry', (setup && setup.entryFmt) || '--'],
      ['SL', (setup && setup.slFmt) ? (setup.slFmt + ' (' + setup.slPips + 'p)') : '--'],
      ['TP1 / TP2', hasSignal ? (setup.tp1Fmt + ' / ' + setup.tp2Fmt) : '--'],
      ['Score', (setup && setup.score) ? (setup.score + '/10') : '-']
    ];

    for (var k = 0; k < rows.length; k++) {
      var ry = 148 + k * 44;
      ctx.fillStyle = '#94a3b8';
      ctx.font = '600 11px monospace';
      ctx.fillText(rows[k][0], panelX + 16, ry);

      ctx.fillStyle = '#f1f5f9';
      ctx.font = 'bold 13px monospace';
      ctx.fillText(String(rows[k][1]), panelX + 16, ry + 17);
    }

    ctx.fillStyle = '#64748b';
    ctx.font = '11px monospace';
    ctx.fillText('Liamvtrade Quant Terminal (@xliamvr)', 36, h - 22);

    var dataUrl = null;
    try {
      dataUrl = targetCanvas.toDataURL('image/png');
      targetCanvas.dataset.pngDataUrl = dataUrl;
    } catch (e) {}
    return dataUrl;
  }

  function generateTechnicalChartPng(setup, state, regimeInfo) {
    var tempCanvas = document.createElement('canvas');
    tempCanvas.width = 900;
    tempCanvas.height = 520;
    return paintMappingCanvas(tempCanvas, setup, state, regimeInfo);
  }

  function formatSetupSummaryText(setup, state, regimeInfo) {
    if (!setup || setup.status !== 'SIGNAL') {
      return '[LIAMVTRADE] ' + ((state && state.pair) || 'XAUUSD') + ' (' + ((state && state.timeframe) || 'M15') + ') — ' + ((setup && setup.status) || 'NO SETUP') + ': ' + ((setup && setup.poiSummary) || 'Belum ada setup valid.');
