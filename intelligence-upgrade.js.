  function renderChartMtfGrid(scanData) {
    if (!scanData || !Array.isArray(scanData.results)) return;
    scanData.results.forEach(function (item) {
      var tf = item.timeframe;
      var dot = document.getElementById('mtf-dot-' + tf);
      var biasEl = document.getElementById('mtf-bias-' + tf);
      var noteEl = document.getElementById('mtf-note-' + tf);

      var isSig = item.status === 'SIGNAL';
      var isWait = item.status === 'WAIT';

      if (dot) {
        dot.className = 'w-1.5 h-1.5 rounded-full ' + (
          isSig ? 'bg-emerald-400' : isWait ? 'bg-amber-400' : 'bg-rose-400'
        );
      }
      if (biasEl) {
        biasEl.textContent = isSig ? (item.direction + ' (' + item.score + ')') : item.status;
      }
      if (noteEl) {
        noteEl.textContent = isSig
          ? (item.orderType + ' • SL ' + item.slPips + 'p')
          : (item.poiSummary || item.reasonCode || 'No Setup');
      }
    });
  }

  function runChartScreeningAndMapping(shouldShowCard) {
    var showCard = shouldShowCard !== false;
    var bridge = getBridge();
    var st = (bridge && typeof bridge.getState === 'function')
      ? bridge.getState()
      : getFallbackTerminalState();

    var chartSelect = document.getElementById('chart-pair-select');
    var pair = (chartSelect && chartSelect.value) || st.pair || 'XAUUSD';
    var tf = st.timeframe || 'M15';
    var method = st.method || 'auto';
    var stPrices = st.prices || {};

    var scanData = runFourTimeframeScan(st, {
      pair: pair,
      timeframe: tf,
      method: method,
      livePrice: stPrices[pair],
      lastUpdateTs: st.lastPriceUpdateMs || Date.now(),
      forceReanalyze: true
    });

    renderChartMtfGrid(scanData);

    var activeSetup =
      scanData.results.find(function (r) { return r && r.timeframe === tf; }) ||
      scanData.best ||
      null;
    var regimeInfo = detectMarketRegime(st, activeSetup);

    var highEl = document.getElementById('chart-swing-high');
    var lowEl = document.getElementById('chart-swing-low');
    var rangeEl = document.getElementById('chart-active-range');
    var verdictBox = document.getElementById('chart-scan-verdict-box');

    if (activeSetup && activeSetup.status === 'SIGNAL') {
      if (highEl) highEl.textContent = activeSetup.tp3Fmt || activeSetup.tp2Fmt || '--';
      if (lowEl) lowEl.textContent = activeSetup.slFmt || '--';
      if (rangeEl) rangeEl.textContent = activeSetup.zoneRangeFormatted || '--';
      if (verdictBox) {
        verdictBox.innerHTML = '<strong class="text-emerald-300">' + pair + ' (' + activeSetup.timeframe + ') — ' + activeSetup.direction + ' ' + activeSetup.orderType + '</strong> • Score ' + activeSetup.score + '/10. Zona POI: <span class="font-mono text-sky-300">' + activeSetup.zoneRangeFormatted + '</span>, Entry <span class="font-mono text-amber-300">' + activeSetup.entryFmt + '</span>, SL <span class="font-mono text-rose-300">' + activeSetup.slFmt + '</span>.';
      }
    } else {
      if (highEl) highEl.textContent = '--';
      if (lowEl) lowEl.textContent = '--';
      if (rangeEl) rangeEl.textContent = '--';
      if (verdictBox) {
        verdictBox.innerHTML = '<strong class="text-amber-300">' + pair + ' (' + tf + ') — ' + ((activeSetup && activeSetup.status) || 'NO SETUP') + '</strong>: ' + ((activeSetup && activeSetup.poiSummary) || 'Belum ada konfluensi struktur valid saat ini.');
      }
    }

    var card = document.getElementById('auto-mapping-result-card');
    var targetCanvas = document.getElementById('mapping-canvas');
    var titleEl = document.getElementById('mapping-board-title');
    var badgeEl = document.getElementById('mapping-verdict-badge');
    var breakdownEl = document.getElementById('mapping-areas-breakdown');

    if (showCard && card) {
      card.classList.remove('hidden');
      card.style.display = 'block';
    }
    if (titleEl) {
      titleEl.textContent = 'Peta Struktur ' + pair + ' (' + ((activeSetup && activeSetup.timeframe) || tf) + ')';
    }
    if (badgeEl) {
      badgeEl.textContent = (activeSetup && activeSetup.status) || 'NO SETUP';
    }

    var mergedState = {
      pair: pair,
      timeframe: (activeSetup && activeSetup.timeframe) || tf,
      method: method,
      prices: stPrices
    };
    var dataUrl = paintMappingCanvas(targetCanvas, activeSetup, mergedState, regimeInfo);

    if (breakdownEl) {
      var mtfSummary = scanData.results
        .map(function (r) { return r.timeframe + ': <strong>' + (r.status === 'SIGNAL' ? r.direction : r.status) + '</strong>'; })
        .join(' • ');
      breakdownEl.innerHTML =
        '<div><strong>Screening 4-TF:</strong> ' + mtfSummary + '</div>' +
        '<div><strong>Regime:</strong> ' + regimeInfo.regime + ' — ' + regimeInfo.suggestedAction + '</div>' +
        '<div><strong>Catatan POI:</strong> ' + ((activeSetup && activeSetup.poiSummary) || 'Menunggu struktur valid.') + '</div>';
    }

    global.__LATEST_MAPPING_STATE__ = {
      setup: activeSetup,
      state: mergedState,
      regime: regimeInfo,
      dataUrl: dataUrl
    };
  }

  function wireIntelligenceModule() {
    var bridge = getBridge();
    if (!bridge || typeof bridge.getState !== 'function') return;

    var latestSetup = null;
    var latestRegime = null;

    var refreshIntelligence = function (setup) {
      latestSetup = setup;
      var st = bridge.getState();
      latestRegime = detectMarketRegime(st, setup);

      var regimeBox = document.getElementById('marketRegimeBox');
      if (regimeBox && latestRegime) {
        regimeBox.innerHTML =
          '<div class="flex items-center justify-between gap-2 mb-1">' +
          '<span class="text-xs font-extrabold tracking-wide text-slate-100">MARKET REGIME</span>' +
          '<span class="px-2 py-0.5 rounded text-[11px] font-bold" style="background:' + latestRegime.badgeColor + '22;color:' + latestRegime.badgeColor + ';border:1px solid ' + latestRegime.badgeColor + '55;">' +
          latestRegime.regime +
          '</span>' +
          '</div>' +
          '<p class="text-xs text-slate-300 leading-relaxed">' + latestRegime.summary + '</p>' +
          '<p class="text-[11px] font-mono text-sky-300 mt-1">Action: ' + latestRegime.suggestedAction + '</p>';
      }

      var scanData = runFourTimeframeScan(st, {
        pair: st.pair,
        method: st.method,
        livePrice: st.prices && st.prices[st.pair],
        lastUpdateTs: st.lastPriceUpdateMs || Date.now()
      });

      renderFourTimeframeGrid('fourTfScanGrid', scanData, function (tf) {
        st.timeframe = tf;
        if (typeof bridge.runAnalysis === 'function') bridge.runAnalysis({ skipScanIncrement: true });
      });

      var dataUrl = generateTechnicalChartPng(setup, st, latestRegime);
      var previewImg = document.getElementById('technicalChartPreview');
      if (previewImg && dataUrl) {
        previewImg.src = dataUrl;
        previewImg.dataset.pngDataUrl = dataUrl;
      }
    };

    if (typeof bridge.onAnalysis === 'function') {
      bridge.onAnalysis(refreshIntelligence);
    }
  }

  global.scanChartStructure = function () {
    runChartScreeningAndMapping(false);
    showQuickNotice('Scan struktur 4-TF selesai.');
  };

  global.generateTechnicalMappingBoard = function () {
    runChartScreeningAndMapping(true);
    showQuickNotice('Screening & Mapping diperbarui.');
  };

  global.openMappingFromSignals = function () {
    if (typeof global.switchMainTab === 'function') {
      global.switchMainTab('chart');
    }
    setTimeout(function () {
      runChartScreeningAndMapping(true);
    }, 80);
  };

  global.downloadMappingPng = function () {
    var latest = global.__LATEST_MAPPING_STATE__;
    var canvas = document.getElementById('mapping-canvas');
    var url = (canvas && canvas.dataset && canvas.dataset.pngDataUrl) || (latest && latest.dataUrl);
    if (!url) {
      runChartScreeningAndMapping(true);
      url = canvas && canvas.dataset && canvas.dataset.pngDataUrl;
    }
    if (!url) return;
    var a = document.createElement('a');
    a.href = url;
    a.download = 'mapping-' + ((latest && latest.state && latest.state.pair) || 'XAUUSD') + '-' + ((latest && latest.setup && latest.setup.timeframe) || 'M15') + '.png';
    a.click();
    showQuickNotice('PNG peta teknikal diunduh.');
  };

  global.copyMappingSummary = function () {
    var latest = global.__LATEST_MAPPING_STATE__;
    var text = formatSetupSummaryText(latest && latest.setup, latest && latest.state, latest && latest.regime).replace(/\*/g, '');
    if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
      navigator.clipboard.writeText(text).then(function () {
        showQuickNotice('Analisa mapping disalin.');
      }).catch(function () {
        showQuickNotice('Gagal menyalin otomatis.');
      });
    } else {
      showQuickNotice('Clipboard tidak tersedia.');
    }
  };

  global.sendMappingToTelegram = function () {
    var bridge = getBridge();
    var latest = global.__LATEST_MAPPING_STATE__;
    var text = formatSetupSummaryText(latest && latest.setup, latest && latest.state, latest && latest.regime);
    if (bridge && typeof bridge.sendTelegram === 'function') {
      Promise.resolve(bridge.sendTelegram(text)).then(function (ok) {
        showQuickNotice(ok ? 'Mapping terkirim ke Telegram.' : 'Gagal kirim ke Telegram.');
      });
    } else {
      showQuickNotice('Dispatcher Telegram belum siap.');
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', wireIntelligenceModule);
  } else {
    wireIntelligenceModule();
  }

  global.LiamIntelligence = {
    detectMarketRegime: detectMarketRegime,
    runFourTimeframeScan: runFourTimeframeScan,
    renderFourTimeframeGrid: renderFourTimeframeGrid,
    generateTechnicalChartPng: generateTechnicalChartPng,
    formatSetupSummaryText: formatSetupSummaryText
  };
})(window);
