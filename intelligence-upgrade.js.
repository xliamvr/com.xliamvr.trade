  };

  global.copyMappingSummary = async function () {
    const latest = global.__LATEST_MAPPING_STATE__;
    const text = formatSetupSummaryText(latest?.setup, latest?.state, latest?.regime).replace(/\*/g, '');
    try {
      await navigator.clipboard.writeText(text);
      if (bridge && typeof bridge.toast === 'function') bridge.toast('Analisa mapping disalin.', 'success');
    } catch (_) {}
  };

  global.sendMappingToTelegram = async function () {
    const latest = global.__LATEST_MAPPING_STATE__;
    const text = formatSetupSummaryText(latest?.setup, latest?.state, latest?.regime);
    if (bridge && typeof bridge.sendTelegram === 'function') {
      const ok = await bridge.sendTelegram(text);
      if (bridge && typeof bridge.toast === 'function') {
        bridge.toast(ok ? 'Mapping terkirim ke Telegram.' : 'Gagal kirim ke Telegram.', ok ? 'success' : 'warn');
      }
    }
  };

  global.LiamIntelligence = {
    detectMarketRegime,
    runFourTimeframeScan,
    renderFourTimeframeGrid,
    generateTechnicalChartPng,
    formatSetupSummaryText
  };
})(window);
